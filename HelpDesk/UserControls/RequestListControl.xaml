<UserControl x:Class="HelpDesk.UserControls.RequestListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HelpDesk.UserControls" xmlns:helpdesk="clr-namespace:HelpDesk" 
             mc:Ignorable="d" 
             Height="550" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="17*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        <Label Content="Ваши заявки:" Grid.ColumnSpan="2"/>
        <ListView Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0" Name="RequestListBox" MouseDoubleClick="RequestInfo"
                  Margin="20,5,35,15" ItemsSource="{Binding RequestList}" SelectionMode="Extended">
            <ListView.Resources>
                <!-- Стиль для отключения действий при нажатии на заголовки столбцов -->
                <Style TargetType="GridViewColumnHeader">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ColumnHeader_Click" />
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Key}">Тег</GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Theme}" Width="100">Тема</GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Status}">Статус</GridViewColumn>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Contractor}">Исполнитель</GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        
        <Button Grid.Column="1" 
                Margin="10,10,35,10" 
                Content="Создать заявку"
                Command="{Binding AddRequestWindow}"/>
    </Grid>
</UserControl>
