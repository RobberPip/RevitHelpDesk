<UserControl x:Class="HelpDesk.UserControls.FileDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HelpDesk.UserControls"
             mc:Ignorable="d"
             x:Name="this"
             Height="100" MinWidth="100" MinHeight="100"
             Background="White">
    <Border BorderBrush="Black" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="110*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14*"/>
                <RowDefinition Height="44*"/>
                <RowDefinition Height="21*"/>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0" Source="/HelpDesk;component/Resources/download_327734.png" Margin="10,10,10,10" Grid.ColumnSpan="2" Grid.RowSpan="2"/>

            <TextBlock Grid.Row="1" 
                       TextTrimming="CharacterEllipsis" FontSize="8" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{Binding FileDetail.FileName, ElementName=this, FallbackValue=FileName, TargetNullValue=FileName}" Grid.ColumnSpan="2" Margin="0,43,0,0" Grid.RowSpan="2"/>
            <TextBlock Grid.Row="2"
                       TextTrimming="CharacterEllipsis" FontSize="8" TextWrapping="NoWrap" TextAlignment="Center"
                       Text="{Binding FileDetail.FileSize, ElementName=this, FallbackValue=FileSize, TargetNullValue=FileSize}" Margin="0,20,0,0" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
            <Button Grid.Column="0" Grid.Row="0" FontSize="4" Content="❌" Margin="0,0,0,0" Command="{Binding FileDelete}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:FileDetailControl}}}"/>

        </Grid>
    </Border>
</UserControl>
