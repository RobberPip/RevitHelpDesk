<UserControl x:Class="HelpDesk.UserControls.RequestInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HelpDesk.UserControls"
             xmlns:helpdesk="clr-namespace:HelpDesk" 
             mc:Ignorable="d" 
             Height="550" Width="500" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="17*"/>
        </Grid.RowDefinitions>
        <Label Content="{Binding Heading}" Margin="15,0,125,97"/>
        <Button Command="{Binding GoBack}" Content="Назад" Margin="390,9,35,98"/>
        <TextBox Text="{Binding Message}" Margin="20,33,35,32" TextWrapping="Wrap"  KeyDown="TextBox_KeyDown"/>
        <Button Command="{Binding SendInfo}" Margin="385,93,35,10" Content="Отправить"/>
        <Button Content="Добавить файлы" Command="{Binding FileAdd}" Margin="125,93,273,10"/>
        <Button Content="Сделать скриншот" Command="{Binding TakeScreenshot}" Margin="20,93,375,10"/>
        <Label Content="Активность" Margin="15,95,405,305" Grid.Row="1"/>
        <ScrollViewer Grid.Row="1" Margin="20,120,35,20">
            <StackPanel Background="LightGray">
                <ItemsControl ItemsSource="{Binding AuthorsDictionary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Value.Name}" />
                                <TextBlock Text="{Binding Value.Comment}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto"  Margin="20,115,35,335" Grid.RowSpan="2">
            <ItemsControl ItemsSource="{Binding AdvanceFiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
